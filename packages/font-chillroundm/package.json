{
  "name": "@proj-airi/font-chillroundm",
  "type": "module",
  "version": "0.9.0",
  "description": "Essential CSS for font, ChillRoundM (a.k.a. \u5bd2\u8749\u534a\u5706\u4f53), used by Project AIRI",
  "author": {
    "name": "Warren2060",
    "email": "87366329+Warren2060@users.noreply.github.com",
    "url": "https://github.com/Warren2060"
  },
  "license": "SIL Open Font License",
  "homepage": "https://github.com/Warren2060/ChillRound",
  "repository": {
    "type": "git",
    "url": "https://github.com/moeru-ai/airi.git",
    "directory": "packages/font-chillroundm"
  },
  "exports": {
    ".": {
      "default": "./dist/index.css"
    },
    "./index.css": {
      "default": "./dist/index.css"
    },
    "./files/*": {
      "default": "./dist/files/*"
    },
    "./files/*.ttf": {
      "default": "./dist/files/*.ttf"
    },
    "./files/*.otf": {
      "default": "./dist/files/*.otf"
    },
    "./*": {
      "default": "./*.css"
    }
  },
  "main": "./dist/index.css",
  "scripts": {
    "dev": "node init && pnpm run build",
    "build": "node init && tsdown"
  }
}
